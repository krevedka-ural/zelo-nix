#!/usr/bin/env python3
"""zelo - Zelotes F-36 RGB panel color picker.

    zelo -c red
    zelo -m rainbow
    zelo -c "#ff8800" -s 3 -l 4
    zelo                      # show saved state

The mouse can't be read back reliably, so the last color/mode/speed/light are
kept in ~/.config/zelo/state.json and re-sent together on every call.

Protocol (reverse-engineered from the vendor driver): HID feature report,
report ID 0x08, 15 bytes, "write memory" command 0x03 at address 0x0035:
  08 03 00 00 35 07 <mode> <R> <G> <B> <speed> <light> <chk7> 00 <chk15>
  chk = (0x55 - sum(previous bytes)) & 0xff
Sent straight to /dev/hidrawN via HIDIOCSFEATURE, no third-party modules.
"""
import argparse
import fcntl
import glob
import json
import os
import sys

VID, PID = 0x25A7, 0xFA68
LED_ADDR = 0x0035

COLORS = {
    "red": (255, 0, 0),
    "green": (0, 255, 0),
    "blue": (0, 0, 255),
    "cyan": (0, 255, 255),
    "magenta": (255, 0, 255),
    "white": (255, 255, 255),
    "yellow": (255, 255, 0),
    "yelow": (255, 255, 0),  # sic, accepted as in the draft
    "orange": (255, 128, 0),
}

# mode byte = 0-based index of the radio button in the original UI.
# NOTE: order is inferred from the driver, not tested on the device.
MODES = {
    "off": 4,
    "static": 1,           # "Steady"
    "rainbow": 2,          # "Colorful"
    "rainbow_clippy": 0,   # "Neon" (guess)
    "breathing": 3,        # extra, "Respiration"
}
OFF = MODES["off"]

STATE_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "zelo", "state.json")
DEFAULT = {"mode": "static", "color": [255, 255, 255], "speed": 2, "light": 2}


def load_state():
    try:
        with open(STATE_PATH) as f:
            return {**DEFAULT, **json.load(f)}
    except (OSError, ValueError):
        return dict(DEFAULT)


def save_state(st):
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    with open(STATE_PATH, "w") as f:
        json.dump(st, f)


def parse_color(s):
    s = s.lower()
    if s in COLORS:
        return list(COLORS[s])
    h = s.lstrip("#")
    if len(h) == 6:
        try:
            return [int(h[i:i + 2], 16) for i in (0, 2, 4)]
        except ValueError:
            pass
    raise argparse.ArgumentTypeError(
        f"unknown color '{s}' (names: {', '.join(k for k in COLORS if k != 'yelow')}, or #rrggbb)")


def chk(data):
    return (0x55 - sum(data)) & 0xFF


def build_packet(st):
    r, g, b = st["color"]
    body = [MODES[st["mode"]], r, g, b, st["speed"], st["light"]]
    body.append(chk(body))
    pkt = [0x08, 0x03, 0x00, LED_ADDR >> 8, LED_ADDR & 0xFF, len(body)] + body
    pkt += [0] * (14 - len(pkt))
    pkt.append(chk(pkt))
    return bytes(pkt)


def hidiocsfeature(n):
    # _IOC(_IOC_WRITE | _IOC_READ, 'H', 0x06, n)
    return (3 << 30) | (n << 16) | (ord("H") << 8) | 0x06


def find_nodes():
    want = f"HID_ID=0003:{VID:08X}:{PID:08X}"
    nodes = []
    for d in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(d + "/device/uevent") as f:
                if want in f.read().upper():
                    nodes.append("/dev/" + os.path.basename(d))
        except OSError:
            continue
    return nodes


def send(pkt, only=None):
    nodes = [only] if only else find_nodes()
    if not nodes:
        sys.exit("zelo: mouse not found (25a7:fa68)")
    denied = False
    last = None
    for node in nodes:
        try:
            fd = os.open(node, os.O_RDWR)
        except PermissionError:
            denied = True
            continue
        except OSError as e:
            last = e
            continue
        try:
            fcntl.ioctl(fd, hidiocsfeature(len(pkt)), bytearray(pkt))
            return node
        except OSError as e:  # interface without this feature report
            last = e
        finally:
            os.close(fd)
    if denied:
        sys.exit("zelo: permission denied on /dev/hidraw* "
                 "(enable programs.zelo or add the udev rule)")
    sys.exit(f"zelo: no hidraw interface accepted the report ({last})")


def main():
    ap = argparse.ArgumentParser(
        prog="zelo", description="Zelotes F-36 RGB panel color picker")
    ap.add_argument("-c", "--color", type=parse_color, metavar="COLOR",
                    help="red,green,blue,cyan,magenta,white,yellow,orange or #rrggbb")
    ap.add_argument("-m", "--mode", choices=MODES, metavar="MODE",
                    help="off,static,rainbow,rainbow_clippy (+ breathing)")
    ap.add_argument("-s", "--speed", type=int, metavar="N", help="effect speed (default 2)")
    ap.add_argument("-l", "--light", type=int, metavar="N", help="brightness (default 2)")
    ap.add_argument("-d", "--device", metavar="PATH", help="force /dev/hidrawN")
    ap.add_argument("-n", "--dry-run", action="store_true", help="print packet, don't send")
    a = ap.parse_args()

    st = load_state()
    if not any(v is not None for v in (a.color, a.mode, a.speed, a.light)):
        print(json.dumps(st))
        return

    if a.color is not None:
        st["color"] = a.color
        # picking a color while the panel is off should light it up
        if a.mode is None and MODES[st["mode"]] == OFF:
            st["mode"] = "static"
    if a.mode is not None:
        st["mode"] = a.mode
    if a.speed is not None:
        st["speed"] = a.speed
    if a.light is not None:
        st["light"] = a.light

    pkt = build_packet(st)
    if a.dry_run:
        print(pkt.hex(" "))
        return
    send(pkt, a.device)
    save_state(st)


if __name__ == "__main__":
    main()
